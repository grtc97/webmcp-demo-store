{
    "name": "shopchrem",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config frontend/storefront/vite.config.js",
        "preview": "vite preview --config frontend/storefront/vite.config.js",
        "build": "npm run build:storefront && npm run build:mcp",
        "build:storefront": "vite build --config frontend/storefront/vite.config.js",
        "build:mcp": "vite build --config frontend/mcp-app/vite.config.js",
        "start:mcp": "node backend/mcp-server/index.js",
        "dev:mcp": "npm run build:mcp && node --watch backend/mcp-server/index.js",
        "preview:mcp": "vite --config frontend/mcp-app/vite.config.js --host 127.0.0.1 --open /preview.html",
        "test": "node --test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@fontsource/poppins": "^5.3.0",
        "@modelcontextprotocol/ext-apps": "1.1.2",
        "@modelcontextprotocol/sdk": "1.25.3",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zod": "4.1.13"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.4",
        "prettier": "3.6.2",
        "vite": "^6.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
